properties([
    pipelineTriggers([
        pollSCM('H/2 * * * *')
    ])
])

node {
    def buildOk = false
    def testOk = false

    try {
        stage('Checkout') {
            checkout scm
            sh '''
                echo "Current directory: $(pwd)"
                echo "Files in workspace:"
                ls -la
            '''
        }

        stage('Environment Setup') {
            sh '''
                echo "=== Setting up Python virtual environment ==="
                
                which python3
                python3 --version
                pip --version
                python3 -m venv venv
                
                source venv/bin/activate
                
                python3 -m pip install --upgrade pip
                python3 -m pip install pytest pyinstaller pytest-xml
                
                echo "Virtual environment setup complete"
            '''
        }

        stage('Build') {
             sh '''
                echo "Compiling Python files..."
                python3 -m py_compile sources/add2vals.py sources/calc.py
                echo "Build completed successfully"
            '''
            buildOk = true
        }

        stage('Test') {
            if (buildOk) {
                sh '''
                    echo "Creating test reports directory..."
                    mkdir -p test-reports
                    
                    echo "Running tests..."
                    cd sources
                    python3 -m pytest test_calc.py --verbose --junit-xml=../test-reports/results.xml
                    cd ..
                '''
                
                junit allowEmptyResults: true, testResults: 'test-reports/*.xml'
                testOk = true
            }
        }

        stage('Deliver') {
            if (testOk) {
                sh '''
                    echo "Building executable with pyinstaller..."
                    python3 -m PyInstaller --onefile sources/add2vals.py
                    
                    echo "Listing dist directory:"
                    ls -la dist/ || true
                '''
                archiveArtifacts artifacts: 'dist/add2vals', fingerprint: true
            }
        }
    } catch (Exception e) {
        echo "Pipeline failed: ${e.getMessage()}"
        currentBuild.result = 'FAILURE'
        throw e
    } finally {
        echo 'Pipeline selesai'
        cleanWs()
    }
}