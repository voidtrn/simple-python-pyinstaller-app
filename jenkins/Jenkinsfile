properties([
    pipelineTriggers([
        pollSCM('H/2 * * * *')
    ])
])

node {
    def buildOk = false
    def testOk = false

    try {
        stage('Checkout') {
            checkout scm
            sh '''
                echo "Current directory: $(pwd)"
                echo "Files in workspace:"
                ls -la
            '''
        }

        stage('Environment Setup') {
            sh '''
                echo "=== Setting up Python virtual environment ==="
                
                which python3
                python3 --version
                pip --version
                python3 -m venv venv
                
                . venv/bin/activate
                
                pip install --upgrade pip
                pip install pytest pyinstaller
                
                echo "Virtual environment setup complete"
            '''
        }

        withEnv(["PATH=${env.WORKSPACE}/venv/bin:${env.PATH}"]) {
            stage('Build') {
                sh '''
                    echo "Compiling Python files..."
                    python3 -m py_compile sources/add2vals.py sources/calc.py
                    echo "Build completed successfully"
                '''
                buildOk = true
            }

            stage('Test') {
                if (buildOk) {
                    sh '''
                        echo "Creating test reports directory..."
                        mkdir -p test-reports
                        
                        echo "Running tests..."
                        cd sources
                        pytest test_calc.py --verbose --junit-xml=../test-reports/results.xml
                        cd ..
                    '''
                    
                    junit allowEmptyResults: true, testResults: 'test-reports/*.xml'
                    testOk = true
                }
            }

            stage('Deliver') {
                if (testOk) {
                    sh '''
                        echo "Building executable with pyinstaller..."
                        pyinstaller --onefile sources/add2vals.py
                        
                        echo "Listing dist directory:"
                        ls -la dist/ || true
                    '''
                    archiveArtifacts artifacts: 'dist/add2vals', fingerprint: true
                }
            }

            stage('Manual Approval') {
                if (testOk) {
                    input message: 'Continue to Deploy stage?', ok: 'Proceed'
                }
            }

            stage('Deploy') {
                if (testOk) {
                    sh '''
                        echo "Running..."
                        chmod +x dist/add2vals

                        ./dist/add2vals 5 7 > app.log 2>&1 &
                        
                        APP_PID=$!
                        echo $APP_PID > app.pid

                        echo "App running with PID: $APP_PID"
                        echo "Pipeline paused for 60 seconds so the App can be tested..."

                        sleep 60

                        echo "Stopping..."
                        kill $APP_PID || true

                        echo "Deploy stage completed"
                    '''
                }
            }
        }
    } catch (Exception e) {
        echo "Pipeline failed: ${e.getMessage()}"
        currentBuild.result = 'FAILURE'
        throw e
    } finally {
        echo 'Pipeline selesai'
        cleanWs()
    }
}